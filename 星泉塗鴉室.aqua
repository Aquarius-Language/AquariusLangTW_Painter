變數 畫選單 = 函式() {
    如果 (選單=="") { 回傳 假; }
    變數 左=24; 變數 項目=[];
    如果 (選單=="檔案選單") { 項目=[["新建","新增作品"],["開啟","開啟圖片或作品"],["匯出","儲存／另存新檔"],["取得圖片","從相機或裝置取得"],["尺寸","圖片屬性"],["關於","關於星泉塗鴉室"]]; }
    如果 (選單=="編輯選單") { 左=94; 項目=[["復原","復原"],["重做","重做"],["剪下","剪下選取"],["複製","複製選取"],["貼上","貼上內容"],["系統複製","複製到系統剪貼簿"],["系統貼上","從系統剪貼簿貼上"],["全選","選取全部"],["左轉","向左旋轉九十度"],["半轉","旋轉一百八十度"],["垂直翻轉","垂直翻轉"],["傾斜","傾斜圖片"],["清空圖層","清空目前圖層"]]; }
    如果 (選單=="筆刷選單") { 左=560; 迴圈 (變數 索引=0; 索引<長度(筆刷名稱); 索引++) { 項目=加入(項目,["筆種"+引擎.數字文字(索引),筆刷名稱[索引]]); } }
    變數 上=121; 如果 (選單=="筆刷選單") { 上=223; }
    面板(左,上,229,長度(項目)*35+16);
    迴圈 (變數 索引=0; 索引<長度(項目); 索引++) { 按鈕(項目[索引][0],項目[索引][1],左+8,上+8+索引*35,213,32,真,假); }
    回傳 真;
};
