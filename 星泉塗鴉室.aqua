變數 畫彈窗 = 函式() {
    如果 (彈窗=="") { 回傳 假; }
    如果 (彈窗=="文字") { 畫文字面板(); 回傳 真; }
    介面按鈕=[]; 介面滑桿=[]; 介面畫筆.停用描邊(); 介面畫筆.填色(0,165); 介面畫筆.矩形(0,0,1440,900);
    如果 (彈窗=="色彩") {
        彈窗標題("編輯色彩","混合紅、綠、藍，收藏自己的創作色票。");
        介面畫筆.填色(繪圖.顏色(色彩值[0],色彩值[1],色彩值[2])); 介面畫筆.矩形(488,399,83,136,6);
        變數 通道=["紅色","綠色","藍色"];
        迴圈 (變數 索引=0; 索引<3; 索引++) { 標籤(通道[索引],599,413+索引*46,12,次文字色); 標籤(引擎.數字文字(色彩值[索引]),908,413+索引*46,12,文字色); 滑桿(通道[索引],600,426+索引*46,293,色彩值[索引]/255.0d); }
        按鈕("確認色彩","套用並收藏色彩",749,568,206,35,真,真);
    }
    如果 (彈窗=="尺寸") {
        彈窗標題("調整畫布大小","保留像素、伸縮內容，或調整作品的長寬比例。");
        標籤("寬度（像素）",487,409,12,次文字色); 標籤("高度（像素）",728,409,12,次文字色);
        面板(488,421,210,43); 面板(729,421,225,43);
        按鈕("寬度欄",引擎.數字文字(尺寸寬),491,424,204,37,真,尺寸欄位==0); 按鈕("高度欄",引擎.數字文字(尺寸高),732,424,219,37,真,尺寸欄位==1);
        按鈕("保持比例","維持長寬比例",488,486,210,32,真,維持比例); 按鈕("伸縮內容","伸縮圖片內容",729,486,225,32,真,尺寸伸縮);
        按鈕("百分之五十","縮為五成",488,523,110,27,真,假); 按鈕("百分之兩百","放大兩倍",607,523,110,27,真,假); 標籤("最多四百萬像素。",488,588,11,黯文字色); 按鈕("確認尺寸","套用尺寸",782,573,173,32,真,真);
    }
    如果 (彈窗=="傾斜") { 彈窗標題("傾斜圖片","以角度變換所有圖層，並擴大畫布保留內容。"); 標籤("水平角度",489,424,14,文字色); 標籤("垂直角度",489,478,14,文字色); 按鈕("水平傾斜減少","－",650,399,47,35,真,假); 按鈕("水平傾斜增加","＋",846,399,47,35,真,假); 按鈕("垂直傾斜減少","－",650,454,47,35,真,假); 按鈕("垂直傾斜增加","＋",846,454,47,35,真,假); 置中標籤(角度文字(傾斜橫),774,426,19,薄荷); 置中標籤(角度文字(傾斜縱),774,481,19,薄荷); 按鈕("確認傾斜","套用傾斜",782,573,173,32,真,真); }
    如果 (彈窗=="圖層名稱") { 彈窗標題("圖層名稱","替你的每一層靈感取個名字。"); 面板(487,407,467,63); 標籤(讀取文字()+組字預覽+"│",502,447,20,薄荷); 按鈕("確認圖層名稱","套用名稱",783,567,171,35,真,真); }
    如果 (彈窗=="字型名稱") { 彈窗標題("使用其他字型","輸入此電腦已安裝的字型名稱。"); 面板(487,407,467,63); 標籤(讀取字型名稱()+組字預覽+"│",502,447,20,薄荷); 標籤("字型名稱依系統提供，可能包含其他語言。",488,515,12,次文字色); 按鈕("確認字型","使用字型",783,567,171,35,真,真); }
    如果 (彈窗=="匯出") {
        彈窗標題("儲存你的宇宙","匯出平面圖片，或保留圖層為星泉分層作品。");
        迴圈 (變數 索引=0; 索引<6; 索引++) { 變數 列=繪圖.向下取整(索引/2.0d); 變數 欄=索引-列*2; 按鈕("格式"+引擎.數字文字(索引),格式名稱[索引],488+欄*242,395+列*45,225,36,真,匯出格式==格式協定[索引]); }
        標籤("透明與圖層需使用對應格式保存。",488,561,11,黯文字色); 按鈕("確認匯出","儲存作品 ↗",783,571,171,33,真,真);
    }
    如果 (彈窗=="新建確認" || 彈窗=="開啟確認") {
        彈窗標題("目前作品尚有變更","先儲存你的靈感，或繼續建立新的作品。");
        標籤("繼續會替換目前畫布及復原記錄。",487,420,14,文字色); 按鈕("匯出","先儲存",486,545,139,40,真,真);
        如果 (彈窗=="新建確認") { 按鈕("確認新建","繼續新增作品",708,545,246,40,真,假); } 否則 { 按鈕("確認開啟","繼續開啟圖片",708,545,246,40,真,假); }
    }
    如果 (彈窗=="關於") {
        彈窗標題("星泉塗鴉室","以繁體中文寫程式，用自己的色彩創造世界。");
        圖示("星泉",488,402,53,薄荷); 標籤("讓靈感，湧成作品。",560,428,22,薄荷);
        標籤("使用星泉語言的原生圖形、圖片與應用函式庫。",488,481,13,文字色); 標籤("功能差異與已知限制請見專案說明文件。",488,511,12,次文字色); 按鈕("關閉彈窗","開始創作",783,566,171,36,真,真);
    }
    如果 (彈窗=="說明") {
        彈窗標題("創作小指南","你的工具都在上方與左側；每一步都能復原。");
        標籤("拖曳畫布繪圖；換檔鍵約束形狀比例。",488,413,13,文字色); 標籤("空白鍵＋拖曳平移；滾輪縮放檢視。",488,449,13,文字色);
        標籤("選取後拖曳搬移；四角控制點調整大小。",488,485,13,文字色); 標籤("控制鍵＋復原鍵復原；刪除鍵清除選取。",488,521,13,文字色); 按鈕("關閉彈窗","我知道了",783,567,171,35,真,真);
    }
    回傳 真;
};
變數 畫提示 = 函式() {
    如果 (彈窗!="") { 回傳 假; }
    迴圈 (變數 索引=0; 索引<長度(介面按鈕); 索引++) {
        變數 按=介面按鈕[索引]; 如果 (命中(橫座標,縱座標,按[1],按[2],按[3],按[4]) && 按[4]<=60 && 按[3]<=81) {
            變數 說明=按[0]; 如果 (按[0]=="筆刷") { 說明="筆刷 · 拖曳即可繪圖"; }
            如果 (按[0]=="前景") { 說明="主要繪圖色彩"; } 如果 (按[0]=="背景") { 說明="次要色彩與橡皮擦色彩"; }
            介面畫筆.文字大小(11); 變數 寬=繪圖.文字寬度(說明)+22; 變數 左=繪圖.最小值(橫座標+10,1407-寬); 面板(左,縱座標+22,寬,27); 標籤(說明,左+11,縱座標+41,11,文字色); 回傳 真;
        }
    }
    回傳 假;
};
變數 處理文字輸入 = 函式() {
    如果 (彈窗=="字型名稱") { 字型編輯器[0].提交(星泉.輸入文字()); 組字預覽=""; 繪圖.重繪(); 回傳 真; }
    如果 (正在輸入 || 彈窗=="圖層名稱") { 文字編輯器[0].提交(星泉.輸入文字()); 組字預覽=""; 繪圖.重繪(); }
};
變數 處理組字更新 = 函式() {
    如果 (彈窗=="字型名稱") { 組字預覽=星泉.組字文字(); 字型編輯器[0].組字(組字預覽,星泉.組字位置(),"Utf16"); 繪圖.重繪(); 回傳 真; }
    如果 (正在輸入 || 彈窗=="圖層名稱") { 組字預覽=星泉.組字文字(); 文字編輯器[0].組字(組字預覽,星泉.組字位置(),"Utf16"); 繪圖.重繪(); }
};
變數 處理組字結束 = 函式() {
    如果 (彈窗=="字型名稱") { 字型編輯器[0].取消組字(); 組字預覽=""; 繪圖.重繪(); 回傳 真; }
    如果 (正在輸入 || 彈窗=="圖層名稱") { 文字編輯器[0].取消組字(); 組字預覽=""; 繪圖.重繪(); }
};
變數 設定 = 函式() {
    星泉.開啟畫室(1440,900,"星泉塗鴉室"); 繪圖.影格率(60); 介面畫筆.文字字型(星泉.正黑體); 介面畫筆.文字大小(14); 介面畫筆.停用描邊();
    引擎.新作品(960,600); 視窗=星泉.視窗原生.目前視窗(); 配合畫面();
    # 持續啟用文字輸入，讓離開鍵取消工具而不終止繪圖系統。
    繪圖.開始文字輸入();
    星泉.當按下(處理點擊); 星泉.當拖曳(處理拖曳); 星泉.當放開(處理放開);
    星泉.當移動(函式() { 更新滑鼠(); 繪圖.重繪(); }); 星泉.當按鍵(處理按鍵);
    星泉.當尺寸改變(函式() { 更新版面(); 繪圖.重繪(); });
    星泉.當滾輪(函式() { 如果 (彈窗=="") { 更新滑鼠(); 變數 原=縮放; 如果 (星泉.滾輪距離()>0) { 縮放=繪圖.最大值(0.1d,縮放/1.12d); } 否則 { 縮放=繪圖.最小值(8,縮放*1.12d); } 平移橫=平移橫*縮放/原; 平移縱=平移縱*縮放/原; 繪圖.重繪(); } });
    繪圖.註冊事件("error",處理錯誤);
    星泉.當文字輸入(處理文字輸入);
    星泉.當組字更新(處理組字更新);
    星泉.當組字結束(處理組字結束);
    繪圖.停止持續繪圖(); 印出("星泉塗鴉室已準備完成。");
};
變數 畫固定介面 = 函式() {
    變數 懸停="";
    迴圈 (變數 索引=0; 索引<長度(快取按鈕); 索引++) { 變數 項=快取按鈕[索引]; 如果 (命中(橫座標,縱座標,項[1],項[2],項[3],項[4])) { 懸停=項[0]; } }
    變數 密度=版比例*星泉.像素寬度(繪圖)/星泉.寬度(繪圖);
    變數 鍵=星泉.資料文字([工具,頁籤,檔名,引擎.已修改,引擎.歷程位置,長度(引擎.歷程),引擎.前景,引擎.背景,引擎.粗細,引擎.筆刷,引擎.透明選取,引擎.外框,引擎.填滿,自訂色票,前景選擇,尺規,格線,圖層顯示,全覽,選單,彈窗,懸停,密度]);
    如果 (介面快取==星泉.空值) { 介面快取=繪圖.建立畫布(1440,900); }
    如果 (鍵!=介面快取鍵) {
        介面快取.調整尺寸(1440,900,繪圖.向上取整(1440*密度),繪圖.向上取整(900*密度));
        介面快取.開始繪圖(); 介面快取.背景(夜色); 介面快取.文字字型(星泉.正黑體); 介面快取.停用描邊();
        介面畫筆=介面快取; 畫頂列(); 畫工具帶(); 畫左側(); 介面畫筆=繪圖; 介面快取.結束繪圖();
        快取按鈕=介面按鈕; 快取滑桿=介面滑桿; 介面快取鍵=鍵;
    } 否則 { 介面按鈕=快取按鈕; 介面滑桿=快取滑桿; }
    繪圖.推入樣式(); 繪圖.停用染色(); 繪圖.圖片(介面快取,0,0,1440,900); 繪圖.彈出樣式();
};
變數 繪製 = 函式() {
    收取視窗事件();
    如果 (拖曳=="筆畫" && 工具=="筆刷" && 引擎.筆刷==3) { 引擎.筆畫(前橫,前縱,前橫+0.01d,前縱,假); 重整合成=真; }
    更新版面(); 介面按鈕=[]; 介面滑桿=[]; 繪圖.背景(夜色); 介面畫筆.推入矩陣(); 介面畫筆.平移(版左,版上); 介面畫筆.縮放(版比例); 介面畫筆.停用描邊();
    如果 (全覽) {
        變數 比例=繪圖.最小值(1310.0d/引擎.畫寬,740.0d/引擎.畫高); 變數 寬=引擎.畫寬*比例; 變數 高=引擎.畫高*比例; 介面畫筆.圖片(引擎.更新合成(真),720-寬/2.0d,425-高/2.0d,寬,高); 按鈕("全覽","返回創作畫面",604,816,232,45,真,真);
    } 否則 { 畫固定介面(); 畫工作區(); 如果 (彈窗!="文字") { 畫圖層(); } 畫狀態(); 畫選單(); }
    畫彈窗(); 畫提示(); 介面畫筆.彈出矩陣();
    變數 語意=[]; 迴圈 (變數 索引=0; 索引<長度(介面按鈕); 索引++) { 語意=加入(語意,星泉.語意按鈕(引擎.數字文字(索引),介面按鈕[索引][0])); } 星泉.應用程式.可及性(語意);
    已繪製++;
};
變數 處理錯誤 = 函式() {
    介面畫筆=繪圖; 介面快取鍵="";
    繪圖.停止持續繪圖(); 如果 (次色繪圖) { 引擎.設定參數("前景",原主色); 次色繪圖=假; }
    拖曳=""; 彈窗=""; 選單=""; 正在輸入=假; 重整合成=真;
    通知="操作未完成，請確認檔案格式、瀏覽器權限及視窗焦點。"; 繪圖.重繪();
};
繪圖.執行(設定,繪製);
