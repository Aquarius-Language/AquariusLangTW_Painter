    介面畫筆.填色(0,70); 介面畫筆.矩形(畫布左+7,畫布上+9,寬+1,高+1);
    介面畫筆.填色(233,237,232); 介面畫筆.矩形(畫布左,畫布上,寬,高);
    介面畫筆.圖片(引擎.棋盤,畫布左,畫布上,寬,高);
    如果 (重整合成) { 引擎.更新合成(假); 重整合成=假; }
    介面畫筆.圖片(引擎.合成,畫布左,畫布上,寬,高);
    如果 (拖曳=="形狀") { 介面畫筆.推入矩陣(); 介面畫筆.平移(畫布左,畫布上); 介面畫筆.縮放(畫布比例); 引擎.畫形狀(介面畫筆,工具,起橫,起縱,終橫,終縱); 介面畫筆.彈出矩陣(); }
    如果 (曲線階段>0 || 長度(多邊路徑)>0) { 介面畫筆.推入矩陣(); 介面畫筆.平移(畫布左,畫布上); 介面畫筆.縮放(畫布比例); 如果 (曲線階段>0) { 引擎.曲線圖形(介面畫筆,曲線點); } 如果 (長度(多邊路徑)>0) { 引擎.路徑圖形(介面畫筆,多邊路徑,假); } 介面畫筆.彈出矩陣(); }
    如果 (正在輸入) {
        介面畫筆.推入矩陣(); 介面畫筆.平移(畫布左+文字位置[0]*畫布比例,畫布上+文字位置[1]*畫布比例); 介面畫筆.縮放(畫布比例);
        介面畫筆.填色(引擎.前景); 介面畫筆.停用描邊(); 介面畫筆.文字字型(引擎.字型); 介面畫筆.文字大小(引擎.字級); 介面畫筆.文字行距(引擎.字級*1.35d); 介面畫筆.文字對齊(0,103);
        變數 內容=讀取文字()+組字預覽; 介面畫筆.文字(內容,0,0); 星泉.標示游標(繪圖,文字編輯器[0],引擎.字型,引擎.字級,引擎.前景); 介面畫筆.彈出矩陣(); 介面畫筆.文字字型(星泉.正黑體);
    }
    如果 (格線 && 畫布比例>=4) { 介面畫筆.描邊(52,100); 介面畫筆.描邊粗細(0.5d); 迴圈 (變數 欄=0; 欄<=引擎.畫寬; 欄++) { 變數 橫=畫布左+欄*畫布比例; 如果 (橫>=103 && 橫<=右) { 介面畫筆.線段(橫,畫布上,橫,畫布上+高); } } 迴圈 (變數 列=0; 列<=引擎.畫高; 列++) { 變數 縱=畫布上+列*畫布比例; 如果 (縱>=284 && 縱<=826) { 介面畫筆.線段(畫布左,縱,畫布左+寬,縱); } } }
    介面畫筆.停用填色(); 介面畫筆.描邊(邊線色); 介面畫筆.描邊粗細(1); 介面畫筆.矩形(畫布左-1,畫布上-1,寬+2,高+2);
    如果 (區域寬()==0) { 變數 控點=[[0,0],[0.5d,0],[1,0],[0,0.5d],[1,0.5d],[0,1],[0.5d,1],[1,1]]; 介面畫筆.填色(夜色); 介面畫筆.描邊(薄荷); 迴圈 (變數 索引=0; 索引<8; 索引++) { 介面畫筆.矩形(畫布左+寬*控點[索引][0]-3,畫布上+高*控點[索引][1]-3,6,6); } }
    變數 區=(引擎.選取);
    如果 (區[2]>0 && 區[3]>0) {
        變數 左=畫布左+區[0]*畫布比例; 變數 上=畫布上+區[1]*畫布比例; 變數 選寬=區[2]*畫布比例; 變數 選高=區[3]*畫布比例;
        介面畫筆.描邊(薄荷); 介面畫筆.描邊粗細(1.4d); 介面畫筆.停用填色(); 介面畫筆.矩形(左,上,選寬,選高);
        介面畫筆.填色(夜色); 介面畫筆.矩形(左-3,上-3,6,6); 介面畫筆.矩形(左+選寬-3,上-3,6,6); 介面畫筆.矩形(左-3,上+選高-3,6,6); 介面畫筆.矩形(左+選寬-3,上+選高-3,6,6);
        如果 (工具=="自由選取" && 拖曳=="選取") { 介面畫筆.停用填色(); 介面畫筆.開始圖形(); 迴圈 (變數 索引=0; 索引<長度(自由路徑); 索引++) { 介面畫筆.頂點(畫布左+自由路徑[索引][0]*畫布比例,畫布上+自由路徑[索引][1]*畫布比例); } 介面畫筆.結束圖形(); }
    }
    繪圖.停用裁切(); 介面畫筆.停用描邊();
    如果 (尺規) {
        裁切檢視(103,284,右-103,542);
        迴圈 (變數 索引=0; 索引<=引擎.畫寬; 索引+=100) { 變數 橫=畫布左+索引*畫布比例; 線(橫,285,橫,293,黯文字色); 標籤(引擎.數字文字(索引),橫+3,298,9,次文字色); }
        迴圈 (變數 索引=0; 索引<=引擎.畫高; 索引+=100) { 變數 縱=畫布上+索引*畫布比例; 線(103,縱,109,縱,黯文字色); 標籤(引擎.數字文字(索引),109,縱+3,9,次文字色); } 繪圖.停用裁切();
    }
    如果 (引擎.浮動圖片!=星泉.空值 || 區[2]>0) { 面板(418,790,340,33); 按鈕("確認選取","✓ 確認",425,792,97,28,真,假); 按鈕("裁切","裁切",528,792,69,28,真,假); 按鈕("刪除選取","刪除",600,792,68,28,真,假); 按鈕("取消選取","取消",675,792,75,28,真,假); }
    如果 (曲線階段>0 || 長度(多邊路徑)>0) { 面板(450,790,313,33); 按鈕("完成形狀","完成形狀",458,792,185,28,真,真); 按鈕("取消形狀","取消",650,792,105,28,真,假); }
    變數 游標="一般"; 如果 (在畫布()) { 游標="繪圖"; 如果 (工具=="文字") { 游標="文字"; } 如果 (工具=="移動畫布") { 游標="移動"; } }
    星泉.設定游標(視窗,游標);
};
